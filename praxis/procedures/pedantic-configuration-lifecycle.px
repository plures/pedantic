# Pedantic configuration lifecycle: policy and evidence are PX-owned.

entity ConfigurationRevision:
  prefix: "pedantic:config:"
  fields:
    revision_id: String
    profile_id: String
    source_digest: String
    admission_state: String
    validation_state: String

entity InventoryObservation:
  prefix: "pedantic:inventory-observation:"
  fields:
    observation_id: String
    profile_id: String
    source_digest: String
    host_count: int
    decision: String

entity ComplianceRequest:
  prefix: "pedantic:compliance-request:"
  fields:
    request_id: String
    revision_id: String
    profile_id: String
    actor_id: String

entity ComplianceObservation:
  prefix: "pedantic:compliance-observation:"
  fields:
    observation_id: String
    request_id: String
    revision_id: String
    profile_id: String
    source_digest: String
    request_decision: String

entity EffectAuthorization:
  prefix: "pedantic:effect-authorization:"
  fields:
    authorization_id: String
    request_id: String
    revision_id: String
    source_digest: String
    idempotency_key: String
    capability: String
    decision: String

entity RemediationRequest:
  prefix: "pedantic:remediation-request:"
  fields:
    request_id: String
    revision_id: String
    observation_id: String
    actor_id: String
    idempotency_key: String
    decision: String

entity RemediationApproval:
  prefix: "pedantic:remediation-approval:"
  fields:
    approval_id: String
    request_id: String
    actor_id: String
    approved: bool
    decision: String

entity RemediationExecution:
  prefix: "pedantic:remediation-execution:"
  fields:
    execution_id: String
    authorization_id: String
    idempotency_key: String
    source_digest: String
    decision: String

constraint configuration_requires_source_digest:
  scope: configuration_revision
  phase: admission
  require: revision.source_digest != ""
  severity: error
  message: "A configuration revision requires an immutable source digest."

constraint configuration_admission_requires_immutable_source_digest:
  scope: configuration_revision
  phase: admission
  when: revision.prior_source_digest != ""
  require: revision.prior_source_digest == revision.source_digest
  severity: error
  message: "An admitted configuration revision cannot change its source digest."

constraint compliance_requires_validated_revision:
  scope: compliance_request
  phase: admission
  require: revision.validation_state == "validated"
  severity: error
  message: "Compliance requires a validated configuration revision."

constraint inventory_observation_requires_matching_source_digest:
  scope: inventory_observation
  phase: admission
  require: inventory.source_digest == observation.source_digest
  severity: error
  message: "Inventory observation requires the supplied source digest."

constraint compliance_observation_requires_accepted_request:
  scope: compliance_observation
  phase: admission
  require: request.decision == "accepted"
  severity: error
  message: "Compliance observation requires an accepted PX request."

constraint compliance_observation_requires_matching_source_digest:
  scope: compliance_observation
  phase: admission
  require: revision.source_digest == observation.source_digest
  severity: error
  message: "Compliance observation requires the admitted source digest."

constraint configuration_validation_requires_accepted_admission:
  scope: configuration_validation
  phase: admission
  require: revision.admission_state == "accepted"
  severity: error
  message: "Configuration validation requires an admitted configuration revision."

constraint configuration_validation_requires_matching_source_digest:
  scope: configuration_validation
  phase: admission
  require: revision.source_digest == validation.source_digest
  severity: error
  message: "Configuration validation requires the admitted source digest."

constraint set_requires_pedantic_authorization:
  scope: effect_authorization
  phase: execution
  when: authorization.capability == "dsc_config_set"
  require: authorization.decision == "accepted"
  severity: error
  message: "DSC set is allowed only after an accepted PX authorization."

constraint remediation_requires_drifted_observation:
  scope: remediation_request
  phase: admission
  require: observation.decision == "observed" AND observation.drifted_resource_count > 0
  severity: error
  message: "Remediation requires a recorded compliance observation with drift."

constraint remediation_requires_matching_revision:
  scope: remediation_request
  phase: admission
  require: remediation.revision_id == observation.revision_id
  severity: error
  message: "Remediation must use the revision observed to be drifted."

constraint remediation_requires_actor_and_idempotency_key:
  scope: remediation_request
  phase: admission
  require: remediation.actor_id != "" AND remediation.idempotency_key != ""
  severity: error
  message: "Remediation requires an actor and an idempotency key."

constraint remediation_approval_requires_accepted_request:
  scope: remediation_approval
  phase: admission
  require: remediation.decision == "accepted"
  severity: error
  message: "Approval requires an accepted remediation request."

constraint remediation_approval_requires_explicit_approval:
  scope: remediation_approval
  phase: admission
  require: approval.approved == true
  severity: error
  message: "DSC set requires explicit approval."

constraint remediation_approval_requires_actor_and_identifier:
  scope: remediation_approval
  phase: admission
  require: approval.approval_id != "" AND approval.actor_id != ""
  severity: error
  message: "Remediation approval requires an approval identifier and actor."

constraint remediation_execution_requires_matching_authorization:
  scope: remediation_execution
  phase: execution
  require: authorization.capability == "dsc_config_set" AND authorization.decision == "accepted"
  severity: error
  message: "Remediation execution requires an accepted DSC set authorization."

constraint remediation_execution_requires_matching_source_digest:
  scope: remediation_execution
  phase: execution
  require: revision.source_digest == execution.source_digest
  severity: error
  message: "Remediation execution must use the authorized configuration source digest."

constraint remediation_execution_requires_matching_idempotency_key:
  scope: remediation_execution
  phase: execution
  require: authorization.idempotency_key == execution.idempotency_key
  severity: error
  message: "Remediation execution must use the authorization idempotency key."

procedure admit_configuration_revision(revision: ConfigurationRevision from "configuration_revisions") -> AdmissionDecision into "admission_decisions":
  given: "Admit a configuration revision only when its source and validation evidence are acceptable"
  validate_configuration_revision revision -> $validation
  return {revision_id: revision.revision_id, decision: $validation.decision, reason: $validation.reason}

procedure observe_inventory(observation: InventoryObservation from "inventory_observations") -> InventoryObservation into "inventory_observations":
  given: "Normalize an inventory document only when its declared source digest matches the supplied document"
  validate_inventory_source observation -> $validated
  normalize_inventory_hosts $validated -> $hosts
  return {observation_id: observation.observation_id, source_digest: observation.source_digest, host_count: $hosts.count, decision: "observed"}

procedure authorize_compliance_request(request: ComplianceRequest from "compliance_requests") -> EffectAuthorization into "effect_authorizations":
  given: "Authorize a DSC compliance effect only for an admitted request and validated revision"
  resolve_revision request.revision_id -> $revision
  evaluate_compliance_policy request $revision -> $decision
  return {authorization_id: request.request_id, request_id: request.request_id, capability: "dsc_config_test", decision: $decision.value}

procedure observe_compliance(observation: ComplianceObservation from "compliance_observations") -> ComplianceObservation into "compliance_observations":
  given: "Run a read-only DSC compliance observation only after PX has accepted the request"
  resolve_compliance_request observation.request_id -> $request
  resolve_revision $request.revision_id -> $revision
  authorize_compliance_request $request -> $authorization
  validate_compliance_observation observation $request $revision -> $validated
  observe_dsc_config_test $authorization $validated -> $result
  return {observation_id: observation.observation_id, request_id: observation.request_id, revision_id: $request.revision_id, source_digest: $revision.source_digest}

procedure request_remediation(request: RemediationRequest from "remediation_requests") -> RemediationRequest into "remediation_requests":
  given: "Request a local DSC set only for an observed, drifted configuration revision"
  resolve_compliance_observation request.observation_id -> $observation
  validate_remediation_request request $observation -> $decision
  return {request_id: request.request_id, revision_id: request.revision_id, observation_id: request.observation_id, decision: $decision.value}

procedure approve_remediation(approval: RemediationApproval from "remediation_approvals") -> EffectAuthorization into "effect_authorizations":
  given: "Issue a narrow DSC set authorization only after explicit approval of an accepted remediation request"
  resolve_remediation_request approval.request_id -> $request
  resolve_revision $request.revision_id -> $revision
  validate_remediation_approval approval $request -> $decision
  return {authorization_id: approval.approval_id, request_id: $request.request_id, revision_id: $request.revision_id, source_digest: $revision.source_digest, idempotency_key: $request.idempotency_key, capability: "dsc_config_set", decision: $decision.value}

procedure execute_remediation(execution: RemediationExecution from "remediation_executions") -> RemediationExecution into "remediation_executions":
  given: "Execute a local DSC set only after PX authorization and record a redacted outcome"
  resolve_effect_authorization execution.authorization_id -> $authorization
  resolve_revision $authorization.revision_id -> $revision
  validate_remediation_execution execution $authorization $revision -> $validated
  observe_dsc_config_set $authorization $validated -> $result
  return {execution_id: execution.execution_id, authorization_id: $authorization.authorization_id, source_digest: $revision.source_digest, decision: $result.decision}
