{
  "name": "pedantic-dsc",
  "displayName": "Pedantic DSC",
  "description": "Pedantic: DSC authoring, visualization, and AI-assisted configuration (Simple DSL + SudoLang).",
  "version": "0.10.0",
  "engines": {
    "vscode": ">=1.90.0",
    "node": ">=20.19.0"
  },
  "publisher": "pedantic",
  "license": "BUSL-1.1",
  "repository": {
    "type": "git",
    "url": "https://github.com/plures/pedantic.git"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onLanguage:pedantic-simple-dsc",
    "onLanguage:pedantic-sudolang",
    "onCommand:pedantic.checkPrereqs",
    "onCommand:pedantic.showResourceInventory",
    "onCommand:pedantic.addResourceToProject",
    "onView:pedanticInventory"
  ],
  "main": "dist/extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "restrictedConfigurations": [
        "pedantic.bridge.pwshPath"
      ]
    }
  },
  "files": [
    "dist/**",
    "bridge/**",
    "README.md",
    "LICENSE"
  ],
  "contributes": {
    "languages": [
      {
        "id": "pedantic-simple-dsc",
        "aliases": [
          "Pedantic Simple DSC"
        ],
        "filenamePatterns": [
          "*.simple.dsc.yaml"
        ]
      },
      {
        "id": "pedantic-sudolang",
        "aliases": [
          "Pedantic SudoLang"
        ],
        "filenamePatterns": [
          "*.ssudo"
        ]
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "pedanticInventory",
          "name": "Pedantic Inventory",
          "contextualTitle": "Pedantic Inventory"
        }
      ]
    },
    "commands": [
      {
        "command": "pedantic.generateConfig",
        "title": "Pedantic: Generate DSC from DSL",
        "category": "Pedantic"
      },
      {
        "command": "pedantic.openGraph",
        "title": "Pedantic: Open Resource Graph",
        "category": "Pedantic"
      },
      {
        "command": "pedantic.openAiPanel",
        "title": "Pedantic: Open AI Assistant",
        "category": "Pedantic"
      },
      {
        "command": "pedantic.debugParse",
        "title": "Pedantic: Debug Parse Current Document",
        "category": "Pedantic"
      },
      {
        "command": "pedantic.checkPrereqs",
        "title": "Pedantic: Check DSC Prerequisites",
        "category": "Pedantic"
      },
      {
        "command": "pedantic.showResourceInventory",
        "title": "Pedantic: Show Resource Inventory",
        "category": "Pedantic"
      },
      {
        "command": "pedantic.addResourceToProject",
        "title": "Pedantic: Add DSC Resource to Project",
        "category": "Pedantic"
      }
    ],
    "configuration": {
      "title": "Pedantic",
      "properties": {
        "pedantic.telemetry.enabled": {
          "type": "boolean",
          "default": false,
          "scope": "window",
          "description": "Enable anonymous telemetry (preview)."
        },
        "pedantic.bridge.pwshPath": {
          "type": "string",
          "default": "pwsh",
          "scope": "machine",
          "description": "Path to the PowerShell executable for the DSC bridge. This setting is ignored in untrusted workspaces."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p . --noEmit",
    "bundle": "npm run compile && node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && esbuild src/extension.ts src/server/server.ts --bundle --platform=node --format=cjs --target=node20 --external:vscode --outdir=dist --outbase=src && node -e \"const fs = require('node:fs'); fs.mkdirSync('dist/vendor', { recursive: true }); fs.copyFileSync('node_modules/echarts/dist/echarts.min.js', 'dist/vendor/echarts.min.js');\"",
    "vscode:prepublish": "npm run bundle",
    "watch": "tsc -w -p .",
    "package": "npm run lint && npm test && vsce package --out pedantic-dsc.vsix",
    "lint": "eslint src test --max-warnings 0",
    "build": "npm run bundle",
    "test": "npm run test:build && node --test dist-test/test/bridgeAssets.test.js dist-test/test/pwshBridge.test.js dist-test/test/goldenTests.test.js dist-test/test/inventoryService.test.js dist-test/test/sudoParser.test.js dist-test/test/logic/dsl-logic.test.js dist-test/test/logic/praxis-core.test.js dist-test/test/logic/reactive-state.test.js dist-test/test/webviewProtocol.test.js dist-test/test/clientLifecycle.test.js",
    "test:vsix": "node test/extension-host/run.cjs",
    "test:build": "tsc -p tsconfig.test.json"
  },
  "devDependencies": {
    "@types/node": "26.6.4",
    "@types/vscode": "1.90.0",
    "@typescript-eslint/eslint-plugin": "8.71.1",
    "@typescript-eslint/parser": "8.71.1",
    "@vscode/test-electron": "^3.1.0",
    "esbuild": "0.28.2",
    "eslint": "10.12.0",
    "@vscode/vsce": "^4.0.0",
    "typescript": "6.0.3"
  },
  "dependencies": {
    "chevrotain": "9.1.0",
    "echarts": "^6.1.0",
    "vscode-languageclient": "^10.1.2",
    "vscode-languageserver": "^10.1.2",
    "vscode-languageserver-textdocument": "^1.0.14",
    "yaml": "^2.9.1"
  }
}
