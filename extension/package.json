{
  "name": "pedantic-dsc",
  "displayName": "Pedantic DSC",
  "description": "Pedantic: DSC authoring, visualization, and AI-assisted configuration (Simple DSL + SudoLang).",
  "version": "0.0.1",
  "engines": {
    "vscode": ">=1.90.0"
  },
  "publisher": "pedantic",
  "license": "MIT",
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onLanguage:yaml",
    "onCommand:pedantic.checkPrereqs",
    "onCommand:pedantic.showResourceInventory",
    "onCommand:pedantic.addResourceToProject"
  ],
  "main": "dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "pedantic.generateConfig",
        "title": "Pedantic: Generate DSC from DSL",
        "category": "Pedantic"
      },
      {
        "command": "pedantic.openGraph",
        "title": "Pedantic: Open Resource Graph",
        "category": "Pedantic"
      },
      {
        "command": "pedantic.openAiPanel",
        "title": "Pedantic: Open AI Assistant",
        "category": "Pedantic"
      },
      {
        "command": "pedantic.debugParse",
        "title": "Pedantic: Debug Parse Current Document",
        "category": "Pedantic"
      },
      {
        "command": "pedantic.checkPrereqs",
        "title": "Pedantic: Check DSC Prerequisites",
        "category": "Pedantic"
      },
      {
        "command": "pedantic.showResourceInventory",
        "title": "Pedantic: Show Resource Inventory",
        "category": "Pedantic"
      },
      {
        "command": "pedantic.addResourceToProject",
        "title": "Pedantic: Add DSC Resource to Project",
        "category": "Pedantic"
      }
    ],
    "configuration": {
      "title": "Pedantic",
      "properties": {
        "pedantic.telemetry.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Enable anonymous telemetry (preview)."
        },
        "pedantic.bridge.pwshPath": {
          "type": "string",
          "default": "pwsh",
          "description": "Path to PowerShell executable for DSC bridge."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -w -p .",
    "package": "npm run compile",
    "lint": "echo '(lint placeholder)'",
    "build": "npm run compile",
    "test": "npm run test:build && node --test dist-test/test",
    "test:build": "tsc -p tsconfig.test.json"
  },
  "devDependencies": {
    "@types/vscode": "^1.108.1",
    "@types/node": "^25.0.9",
    "typescript": "^5.4.0",
    "vsce": "^2.15.0",
    "vscode": "^1.1.37"
  },
  "dependencies": {
    "echarts": "^6.0.0",
    "vscode-languageclient": "^9.0.1",
    "vscode-languageserver": "^9.0.1",
    "vscode-languageserver-textdocument": "^1.0.12",
    "chevrotain": "^11.1.0",
    "yaml": "^2.5.0"
  }
}
