{
  "name": "pedantic-dsc",
  "displayName": "Pedantic DSC",
  "description": "Pedantic: DSC authoring, visualization, and AI-assisted configuration (Simple DSL + SudoLang).",
  "version": "0.6.0",
  "engines": {
    "vscode": ">=1.90.0"
  },
  "publisher": "pedantic",
  "license": "MIT",
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onLanguage:yaml",
    "onCommand:pedantic.checkPrereqs",
    "onCommand:pedantic.showResourceInventory",
    "onCommand:pedantic.addResourceToProject",
    "onView:pedanticInventory"
  ],
  "main": "dist/extension.js",
  "contributes": {
    "views": {
      "explorer": [
        {
          "id": "pedanticInventory",
          "name": "Pedantic Inventory",
          "contextualTitle": "Pedantic Inventory"
        }
      ]
    },
    "commands": [
      {
        "command": "pedantic.generateConfig",
        "title": "Pedantic: Generate DSC from DSL",
        "category": "Pedantic"
      },
      {
        "command": "pedantic.openGraph",
        "title": "Pedantic: Open Resource Graph",
        "category": "Pedantic"
      },
      {
        "command": "pedantic.openAiPanel",
        "title": "Pedantic: Open AI Assistant",
        "category": "Pedantic"
      },
      {
        "command": "pedantic.debugParse",
        "title": "Pedantic: Debug Parse Current Document",
        "category": "Pedantic"
      },
      {
        "command": "pedantic.checkPrereqs",
        "title": "Pedantic: Check DSC Prerequisites",
        "category": "Pedantic"
      },
      {
        "command": "pedantic.showResourceInventory",
        "title": "Pedantic: Show Resource Inventory",
        "category": "Pedantic"
      },
      {
        "command": "pedantic.addResourceToProject",
        "title": "Pedantic: Add DSC Resource to Project",
        "category": "Pedantic"
      },
      {
        "command": "pedantic.refreshInventory",
        "title": "Refresh Inventory",
        "category": "Pedantic",
        "icon": "$(refresh)"
      },
      {
        "command": "pedantic.showInventoryDetail",
        "title": "Show Details",
        "category": "Pedantic"
      },
      {
        "command": "pedantic.gatherHostFacts",
        "title": "Gather Facts",
        "category": "Pedantic",
        "icon": "$(cloud-download)"
      },
      {
        "command": "pedantic.pushConfigToHost",
        "title": "Push Configuration",
        "category": "Pedantic",
        "icon": "$(cloud-upload)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "pedantic.refreshInventory",
          "when": "view == pedanticInventory",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "pedantic.gatherHostFacts",
          "when": "view == pedanticInventory && viewItem == host",
          "group": "inline"
        },
        {
          "command": "pedantic.pushConfigToHost",
          "when": "view == pedanticInventory && viewItem == host",
          "group": "inline"
        }
      ]
    },
    "configuration": {
      "title": "Pedantic",
      "properties": {
        "pedantic.telemetry.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Enable anonymous telemetry (preview)."
        },
        "pedantic.bridge.pwshPath": {
          "type": "string",
          "default": "pwsh",
          "description": "Path to PowerShell executable for DSC bridge."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -w -p .",
    "package": "npm run compile",
    "lint": "echo '(lint placeholder)'",
    "build": "npm run compile",
    "test": "npm run test:build && node --test dist-test/test",
    "test:build": "tsc -p tsconfig.test.json"
  },
  "devDependencies": {
    "@types/node": "26.5.1",
    "@types/vscode": "1.137.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.9.2",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "chevrotain": "^13.2.0",
    "echarts": "^6.1.0",
    "vscode-languageclient": "^10.1.1",
    "vscode-languageserver": "^10.1.1",
    "vscode-languageserver-textdocument": "^1.0.15",
    "yaml": "^2.9.1"
  }
}
