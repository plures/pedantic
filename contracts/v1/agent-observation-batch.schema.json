{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.pedantic.dev/contracts/v1/agent-observation-batch.schema.json",
  "title": "Pedantic agent observation batch",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "batchId", "agentId", "targetId", "profileId", "firstSequence", "lastSequence", "observations", "signature"],
  "properties": {
    "schemaVersion": { "const": "pedantic.agent-observation-batch.v1" }, "batchId": { "type": "string", "minLength": 1 },
    "agentId": { "type": "string", "minLength": 1 }, "targetId": { "type": "string", "minLength": 1 }, "profileId": { "type": "string", "minLength": 1 },
    "firstSequence": { "type": "integer", "minimum": 1 }, "lastSequence": { "type": "integer", "minimum": 1 },
    "observations": { "type": "array", "minItems": 1, "items": { "$ref": "https://schemas.pedantic.dev/contracts/v1/effect-observation.schema.json" } },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "keyId", "payloadDigest", "value"],
      "properties": {
        "algorithm": { "const": "Ed25519" },
        "keyId": { "type": "string", "minLength": 1, "maxLength": 256 },
        "payloadDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "value": { "type": "string", "pattern": "^[A-Za-z0-9_-]{86}$" }
      }
    }
  }
}
