{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.pedantic.dev/contracts/v1/local-service-request.schema.json",
  "title": "Pedantic local service request",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "method", "profileId", "authorization"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "method": {
      "enum": [
        "service.health",
        "evidence.list",
        "configuration.admit",
        "configuration.validate",
        "inventory.observe",
        "compliance.request",
        "compliance.observe",
        "remediation.request",
        "remediation.approve",
        "approval.record",
        "effect.authorize",
        "remediation.execute",
        "transfer.record",
        "transfer.reconcile",
        "transfer.query",
        "transfer.report",
        "transfer.retain"
      ]
    },
    "profileId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9_][A-Za-z0-9_-]*$"
    },
    "authorization": { "type": "string", "minLength": 32 },
    "params": { "type": ["object", "null"] }
  },
  "allOf": [
    {
      "if": { "properties": { "method": { "const": "service.health" } } },
      "then": { "properties": { "params": { "type": "null" } } }
    },
    {
      "if": { "properties": { "method": { "const": "evidence.list" } } },
      "then": { "properties": { "params": { "type": "null" } } }
    },
    {
      "if": { "properties": { "method": { "const": "transfer.record" } } },
      "then": {
        "required": ["params"],
        "properties": {
          "params": {
            "type": "object",
            "additionalProperties": false,
            "required": ["event"],
            "properties": { "event": { "type": "object" } }
          }
        }
      }
    },
    {
      "if": { "properties": { "method": { "const": "transfer.reconcile" } } },
      "then": {
        "required": ["params"],
        "properties": {
          "params": {
            "type": "object",
            "additionalProperties": false,
            "required": ["registry"],
            "properties": { "registry": { "type": "object" } }
          }
        }
      }
    },
    {
      "if": { "properties": { "method": { "const": "transfer.query" } } },
      "then": {
        "required": ["params"],
        "properties": {
          "params": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "operationId": { "type": "string" },
              "sourceVm": { "type": "string" },
              "targetVm": { "type": "string" },
              "targetHost": { "type": "string" },
              "active": { "type": "boolean" }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "method": { "const": "transfer.report" } } },
      "then": {
        "required": ["params"],
        "properties": {
          "params": {
            "type": "object",
            "additionalProperties": false,
            "required": ["operationId"],
            "properties": { "operationId": { "type": "string", "minLength": 1 } }
          }
        }
      }
    },
    {
      "if": { "properties": { "method": { "const": "transfer.retain" } } },
      "then": {
        "required": ["params"],
        "properties": {
          "params": {
            "type": "object",
            "additionalProperties": false,
            "required": ["retainAfter"],
            "properties": { "retainAfter": { "type": "integer", "minimum": 0 } }
          }
        }
      }
    },
    {
      "if": { "properties": { "method": { "const": "configuration.admit" } } },
      "then": {
        "required": ["params"],
        "properties": {
          "params": {
            "type": "object",
            "additionalProperties": false,
            "required": ["revisionId", "sourceDigest"],
            "properties": {
              "revisionId": { "type": "string" },
              "sourceDigest": { "type": "string" }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "method": { "const": "configuration.validate" } } },
      "then": {
        "required": ["params"],
        "properties": {
          "params": {
            "type": "object",
            "additionalProperties": false,
            "required": ["revisionId", "document"],
            "properties": {
              "revisionId": { "type": "string" },
              "document": { "type": "string" }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "method": { "const": "inventory.observe" } } },
      "then": {
        "required": ["params"],
        "properties": {
          "params": {
            "type": "object",
            "additionalProperties": false,
            "required": ["observationId", "sourceDigest", "document"],
            "properties": {
              "observationId": { "type": "string" },
              "sourceDigest": { "type": "string" },
              "document": { "type": "string" }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "method": { "const": "compliance.request" } } },
      "then": {
        "required": ["params"],
        "properties": {
          "params": {
            "type": "object",
            "additionalProperties": false,
            "required": ["requestId", "revisionId"],
            "properties": {
              "requestId": { "type": "string" },
              "revisionId": { "type": "string" }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "method": { "const": "compliance.observe" } } },
      "then": {
        "required": ["params"],
        "properties": {
          "params": {
            "type": "object",
            "additionalProperties": false,
            "required": ["observationId", "requestId", "document"],
            "properties": {
              "observationId": { "type": "string" },
              "requestId": { "type": "string" },
              "document": { "type": "string" }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "method": { "const": "remediation.request" } } },
      "then": {
        "required": ["params"],
        "properties": {
          "params": {
            "type": "object",
            "additionalProperties": false,
            "required": ["requestId", "revisionId", "observationId", "actorId", "idempotencyKey"],
            "properties": {
              "requestId": { "type": "string", "minLength": 1 },
              "revisionId": { "type": "string", "minLength": 1 },
              "observationId": { "type": "string", "minLength": 1 },
              "actorId": { "type": "string", "minLength": 1 },
              "idempotencyKey": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "method": { "enum": ["remediation.approve", "approval.record", "effect.authorize"] } } },
      "then": {
        "required": ["params"],
        "properties": {
          "params": {
            "type": "object",
            "additionalProperties": false,
            "required": ["approvalId", "requestId", "actorId", "approved"],
            "properties": {
              "approvalId": { "type": "string", "minLength": 1 },
              "requestId": { "type": "string", "minLength": 1 },
              "actorId": { "type": "string", "minLength": 1 },
              "approved": { "type": "boolean" }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "method": { "const": "remediation.execute" } } },
      "then": {
        "required": ["params"],
        "properties": {
          "params": {
            "type": "object",
            "additionalProperties": false,
            "required": ["executionId", "authorizationId", "idempotencyKey", "document"],
            "properties": {
              "executionId": { "type": "string", "minLength": 1 },
              "authorizationId": { "type": "string", "minLength": 1 },
              "idempotencyKey": { "type": "string", "minLength": 1 },
              "document": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    }
  ]
}
