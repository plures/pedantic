{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.pedantic.dev/contracts/v1/operation-definition.schema.json",
  "title": "Pedantic operation definition",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "operationId", "profileId", "actorId", "targetId", "idempotencyKey", "correlationId"],
  "properties": {
    "schemaVersion": { "const": "pedantic.operation-definition.v1" },
    "operationId": { "$ref": "#/definitions/identifier" },
    "profileId": { "$ref": "#/definitions/identifier" },
    "actorId": { "$ref": "#/definitions/identifier" },
    "targetId": { "$ref": "#/definitions/identifier" },
    "idempotencyKey": { "$ref": "#/definitions/identifier" },
    "causationId": { "$ref": "#/definitions/identifier" },
    "correlationId": { "$ref": "#/definitions/identifier" },
    "configurationRevision": { "$ref": "#/definitions/identifier" },
    "configurationDigest": { "$ref": "#/definitions/digest" }
  },
  "definitions": {
    "identifier": { "type": "string", "minLength": 1, "maxLength": 256 },
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
  }
}
