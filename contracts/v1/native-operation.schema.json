{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.pedantic.dev/contracts/v1/native-operation.schema.json",
  "title": "Pedantic native operation contract set",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "operation", "target", "facts", "capabilityDescriptors", "providerDescriptors", "sparsePlan", "resolvedPlan", "steps", "attempts", "effectRequests", "effectObservations", "approvals", "suspensions", "agentDeployments", "agentLeases", "cleanupManifest", "evidenceReferences"],
  "properties": {
    "schemaVersion": { "const": "pedantic.native-operation.v1" },
    "operation": { "$ref": "#/definitions/operation" },
    "target": { "$ref": "#/definitions/target" },
    "facts": { "type": "array", "items": { "$ref": "#/definitions/factObservation" } },
    "capabilityDescriptors": { "type": "array", "items": { "$ref": "#/definitions/capabilityDescriptor" } },
    "providerDescriptors": { "type": "array", "items": { "$ref": "#/definitions/providerDescriptor" } },
    "sparsePlan": { "$ref": "#/definitions/sparsePlan" },
    "resolvedPlan": { "$ref": "#/definitions/resolvedPlan" },
    "steps": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/step" } },
    "attempts": { "type": "array", "items": { "$ref": "#/definitions/attempt" } },
    "effectRequests": { "type": "array", "items": { "$ref": "#/definitions/effectRequest" } },
    "effectObservations": { "type": "array", "items": { "$ref": "#/definitions/effectObservation" } },
    "approvals": { "type": "array", "items": { "$ref": "#/definitions/approval" } },
    "suspensions": { "type": "array", "items": { "$ref": "#/definitions/suspension" } },
    "agentDeployments": { "type": "array", "items": { "$ref": "#/definitions/agentDeployment" } },
    "agentLeases": { "type": "array", "items": { "$ref": "#/definitions/agentLease" } },
    "cleanupManifest": { "$ref": "#/definitions/cleanupManifest" },
    "evidenceReferences": { "type": "array", "items": { "$ref": "#/definitions/evidenceReference" } }
  },
  "definitions": {
    "id": { "type": "string", "minLength": 1, "maxLength": 256 },
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "time": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "identity": { "type": "object", "required": ["operationId", "planId", "planRevision", "targetId", "correlationId"], "properties": { "operationId": { "$ref": "#/definitions/id" }, "planId": { "$ref": "#/definitions/id" }, "planRevision": { "type": "integer", "minimum": 1 }, "targetId": { "$ref": "#/definitions/id" }, "correlationId": { "$ref": "#/definitions/id" } } },
    "target": { "type": "object", "additionalProperties": false, "required": ["targetId", "kind"], "properties": { "targetId": { "$ref": "#/definitions/id" }, "kind": { "enum": ["host", "service", "resource"] }, "displayName": { "type": "string", "maxLength": 256 } } },
    "factObservation": { "type": "object", "additionalProperties": false, "required": ["factId", "targetId", "observedAt", "valueDigest", "evidenceReferenceId"], "properties": { "factId": { "$ref": "#/definitions/id" }, "targetId": { "$ref": "#/definitions/id" }, "observedAt": { "$ref": "#/definitions/time" }, "valueDigest": { "$ref": "#/definitions/digest" }, "evidenceReferenceId": { "$ref": "#/definitions/id" } } },
    "capabilityDescriptor": { "type": "object", "additionalProperties": false, "required": ["capabilityId", "capability", "version", "effectKinds"], "properties": { "capabilityId": { "$ref": "#/definitions/id" }, "capability": { "type": "string", "pattern": "^[a-z][a-z0-9.-]*/v[1-9][0-9]*$" }, "version": { "type": "string", "pattern": "^v[1-9][0-9]*$" }, "effectKinds": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/id" } } } },
    "providerDescriptor": { "type": "object", "additionalProperties": false, "required": ["providerId", "capabilityId", "version"], "properties": { "providerId": { "$ref": "#/definitions/id" }, "capabilityId": { "$ref": "#/definitions/id" }, "version": { "type": "string", "pattern": "^v[1-9][0-9]*$" } } },
    "operation": { "type": "object", "additionalProperties": false, "required": ["operationId", "targetId", "correlationId", "intentDigest"], "properties": { "operationId": { "$ref": "#/definitions/id" }, "targetId": { "$ref": "#/definitions/id" }, "correlationId": { "$ref": "#/definitions/id" }, "intentDigest": { "$ref": "#/definitions/digest" } } },
    "sparsePlan": { "type": "object", "additionalProperties": false, "properties": { "operationId": {}, "planId": {}, "planRevision": {}, "targetId": {}, "correlationId": {}, "intentDigest": {} }, "allOf": [{ "$ref": "#/definitions/identity" }, { "type": "object", "required": ["intentDigest"], "properties": { "intentDigest": { "$ref": "#/definitions/digest" } } }] },
    "resolvedPlan": { "type": "object", "additionalProperties": false, "properties": { "operationId": {}, "planId": {}, "planRevision": {}, "targetId": {}, "correlationId": {}, "sparsePlanId": {}, "planDigest": {}, "decisionEvidenceReferenceIds": {} }, "allOf": [{ "$ref": "#/definitions/identity" }, { "type": "object", "required": ["sparsePlanId", "planDigest", "decisionEvidenceReferenceIds"], "properties": { "sparsePlanId": { "$ref": "#/definitions/id" }, "planDigest": { "$ref": "#/definitions/digest" }, "decisionEvidenceReferenceIds": { "type": "array", "items": { "$ref": "#/definitions/id" } } } }] },
    "step": { "type": "object", "additionalProperties": false, "properties": { "operationId": {}, "planId": {}, "planRevision": {}, "targetId": {}, "correlationId": {}, "stepId": {}, "capabilityId": {}, "inputDigest": {} }, "allOf": [{ "$ref": "#/definitions/identity" }, { "type": "object", "required": ["stepId", "capabilityId", "inputDigest"], "properties": { "stepId": { "$ref": "#/definitions/id" }, "capabilityId": { "$ref": "#/definitions/id" }, "inputDigest": { "$ref": "#/definitions/digest" } } }] },
    "attempt": { "type": "object", "additionalProperties": false, "properties": { "operationId": {}, "planId": {}, "planRevision": {}, "targetId": {}, "correlationId": {}, "attemptId": {}, "stepId": {} }, "allOf": [{ "$ref": "#/definitions/identity" }, { "type": "object", "required": ["attemptId", "stepId"], "properties": { "attemptId": { "$ref": "#/definitions/id" }, "stepId": { "$ref": "#/definitions/id" } } }] },
    "execution": { "oneOf": [{ "type": "object", "additionalProperties": false, "required": ["mode", "executorId"], "properties": { "mode": { "const": "agentless" }, "executorId": { "$ref": "#/definitions/id" } } }, { "type": "object", "additionalProperties": false, "required": ["mode", "agentInstanceId", "leaseId"], "properties": { "mode": { "const": "ephemeral-agent" }, "agentInstanceId": { "$ref": "#/definitions/id" }, "leaseId": { "$ref": "#/definitions/id" } } }] },
    "effectRequest": { "type": "object", "additionalProperties": false, "properties": { "operationId": {}, "planId": {}, "planRevision": {}, "targetId": {}, "correlationId": {}, "childEffectId": {}, "authorizationId": {}, "stepId": {}, "attemptId": {}, "planDigest": {}, "execution": {} }, "allOf": [{ "$ref": "#/definitions/identity" }, { "type": "object", "required": ["childEffectId", "authorizationId", "stepId", "attemptId", "planDigest", "execution"], "properties": { "childEffectId": { "$ref": "#/definitions/id" }, "authorizationId": { "$ref": "#/definitions/id" }, "stepId": { "$ref": "#/definitions/id" }, "attemptId": { "$ref": "#/definitions/id" }, "planDigest": { "$ref": "#/definitions/digest" }, "execution": { "$ref": "#/definitions/execution" } } }] },
    "effectObservation": { "type": "object", "additionalProperties": false, "properties": { "operationId": {}, "planId": {}, "planRevision": {}, "targetId": {}, "correlationId": {}, "childEffectId": {}, "attemptId": {}, "status": {}, "evidenceReferenceId": {} }, "allOf": [{ "$ref": "#/definitions/identity" }, { "type": "object", "required": ["childEffectId", "attemptId", "status", "evidenceReferenceId"], "properties": { "childEffectId": { "$ref": "#/definitions/id" }, "attemptId": { "$ref": "#/definitions/id" }, "status": { "enum": ["accepted", "completed", "failed"] }, "evidenceReferenceId": { "$ref": "#/definitions/id" } } }] },
    "approval": { "type": "object", "additionalProperties": false, "properties": { "operationId": {}, "planId": {}, "planRevision": {}, "targetId": {}, "correlationId": {}, "approvalId": {}, "authorizationId": {}, "planDigest": {}, "accepted": {} }, "allOf": [{ "$ref": "#/definitions/identity" }, { "type": "object", "required": ["approvalId", "authorizationId", "planDigest", "accepted"], "properties": { "approvalId": { "$ref": "#/definitions/id" }, "authorizationId": { "$ref": "#/definitions/id" }, "planDigest": { "$ref": "#/definitions/digest" }, "accepted": { "type": "boolean" } } }] },
    "suspension": { "type": "object", "additionalProperties": false, "properties": { "operationId": {}, "planId": {}, "planRevision": {}, "targetId": {}, "correlationId": {}, "suspensionId": {}, "stepId": {}, "reason": {} }, "allOf": [{ "$ref": "#/definitions/identity" }, { "type": "object", "required": ["suspensionId", "stepId", "reason"], "properties": { "suspensionId": { "$ref": "#/definitions/id" }, "stepId": { "$ref": "#/definitions/id" }, "reason": { "type": "string", "minLength": 1 } } }] },
    "agentDeployment": { "type": "object", "additionalProperties": false, "required": ["agentInstanceId", "targetId", "deploymentId"], "properties": { "agentInstanceId": { "$ref": "#/definitions/id" }, "targetId": { "$ref": "#/definitions/id" }, "deploymentId": { "$ref": "#/definitions/id" } } },
    "agentLease": { "type": "object", "additionalProperties": false, "required": ["leaseId", "agentInstanceId", "operationId", "expiresAt"], "properties": { "leaseId": { "$ref": "#/definitions/id" }, "agentInstanceId": { "$ref": "#/definitions/id" }, "operationId": { "$ref": "#/definitions/id" }, "expiresAt": { "$ref": "#/definitions/time" } } },
    "cleanupManifest": { "type": "object", "additionalProperties": false, "required": ["cleanupId", "operationId", "planDigest", "evidenceReferenceIds"], "properties": { "cleanupId": { "$ref": "#/definitions/id" }, "operationId": { "$ref": "#/definitions/id" }, "planDigest": { "$ref": "#/definitions/digest" }, "evidenceReferenceIds": { "type": "array", "items": { "$ref": "#/definitions/id" } } } },
    "evidenceReference": { "type": "object", "additionalProperties": false, "required": ["evidenceReferenceId", "digest", "kind"], "properties": { "evidenceReferenceId": { "$ref": "#/definitions/id" }, "digest": { "$ref": "#/definitions/digest" }, "kind": { "enum": ["fact", "decision", "effect", "cleanup"] } } }
  }
}
