{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.pedantic.dev/contracts/v1/operation-plan.schema.json",
  "title": "Pedantic immutable operation plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "planId", "operationId", "profileId", "targetId", "steps"],
  "properties": {
    "schemaVersion": { "const": "pedantic.operation-plan.v1" },
    "planId": { "$ref": "#/definitions/identifier" },
    "operationId": { "$ref": "#/definitions/identifier" },
    "profileId": { "$ref": "#/definitions/identifier" },
    "targetId": { "$ref": "#/definitions/identifier" },
    "steps": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/step" } }
  },
  "definitions": {
    "identifier": { "type": "string", "minLength": 1, "maxLength": 256 },
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stepId", "stage", "capability", "dependsOn", "retryClass", "inputDigest"],
      "properties": {
        "stepId": { "$ref": "#/definitions/identifier" },
        "stage": { "enum": ["preparation", "execution"] },
        "capability": { "type": "string", "pattern": "^[a-z][a-z0-9.-]*/v[1-9][0-9]*$" },
        "dependsOn": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/definitions/identifier" } },
        "retryClass": { "enum": ["never", "safe", "safe-after-observation", "requires-fresh-authorization", "requires-operator-review", "compensate-then-retry"] },
        "inputDigest": { "$ref": "#/definitions/digest" },
        "secretReferences": { "type": "array", "items": { "$ref": "#/definitions/identifier" } }
      }
    }
  }
}
