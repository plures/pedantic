{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.pedantic.dev/contracts/v1/transfer-launch.schema.json",
  "title": "Pedantic immutable transfer launch checkpoint",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "operationId", "planId", "planDigest", "provider", "authorizationId", "authorizationDigest", "approvalReference", "sourceId", "targetId", "preflightEvidence", "bootIdentity", "idempotencyKey"],
  "properties": {
    "schemaVersion": { "const": "pedantic.transfer-launch.v1" },
    "operationId": { "$ref": "#/definitions/id" },
    "planId": { "$ref": "#/definitions/id" },
    "planDigest": { "$ref": "#/definitions/digest" },
    "provider": { "type": "string", "pattern": "^[a-z][a-z0-9.-]*/v[1-9][0-9]*$" },
    "authorizationId": { "$ref": "#/definitions/id" },
    "authorizationDigest": { "$ref": "#/definitions/digest" },
    "approvalReference": { "$ref": "#/definitions/id" },
    "sourceId": { "$ref": "#/definitions/id" },
    "targetId": { "$ref": "#/definitions/id" },
    "preflightEvidence": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/id" } },
    "bootIdentity": { "$ref": "#/definitions/id" },
    "idempotencyKey": { "$ref": "#/definitions/id" }
  },
  "definitions": {
    "id": { "type": "string", "minLength": 1, "maxLength": 256 },
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
  }
}
