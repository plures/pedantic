{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.pedantic.dev/contracts/v1/hyperv-transfer-plan-result.schema.json",
  "title": "Pedantic Hyper-V transfer planning result",
  "type": "object",
  "additionalProperties": false,
  "required": ["plan", "hostFailures", "validationErrors"],
  "properties": {
    "plan": {
      "anyOf": [
        { "type": "null" },
        { "$ref": "#/definitions/plan" }
      ]
    },
    "hostFailures": {
      "type": "array",
      "items": { "$ref": "#/definitions/hostFailure" }
    },
    "validationErrors": {
      "type": "array",
      "items": { "$ref": "#/definitions/validationError" }
    }
  },
  "definitions": {
    "validationError": {
      "oneOf": [
        { "const": "missingRequestIdentity" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["duplicatePair"],
          "properties": {
            "duplicatePair": {
              "type": "object",
              "additionalProperties": false,
              "required": ["sourceHost", "sourceVmName", "targetHost", "targetVmName"],
              "properties": {
                "sourceHost": { "type": "string" },
                "sourceVmName": { "type": "string" },
                "targetHost": { "type": "string" },
                "targetVmName": { "type": "string" }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["duplicateVmName"],
          "properties": {
            "duplicateVmName": {
              "type": "object",
              "additionalProperties": false,
              "required": ["hostName", "vmName"],
              "properties": {
                "hostName": { "type": "string" },
                "vmName": { "type": "string" }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["missingPairVm"],
          "properties": {
            "missingPairVm": {
              "type": "object",
              "additionalProperties": false,
              "required": ["hostName", "vmName"],
              "properties": {
                "hostName": { "type": "string" },
                "vmName": { "type": "string" }
              }
            }
          }
        }
      ]
    },
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "hostFailure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hostName", "category", "error", "retryable"],
      "properties": {
        "hostName": { "type": "string", "minLength": 1 },
        "category": { "enum": ["authentication", "host-unavailable", "hyper-v-unavailable", "invalid-response"] },
        "error": { "type": "string", "minLength": 1 },
        "retryable": { "type": "boolean" }
      }
    },
    "drive": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "differencingChain"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "differencingChain": { "type": "array", "items": { "type": "string" } }
      }
    },
    "vm": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hostName", "name", "vmId", "effectiveMacAddresses", "hardDrives"],
      "properties": {
        "hostName": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "vmId": { "type": "string", "minLength": 1 },
        "effectiveMacAddresses": { "type": "array", "items": { "type": "string" } },
        "hardDrives": { "type": "array", "items": { "$ref": "#/definitions/drive" } }
      }
    },
    "pair": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pairId", "source", "target", "selectedTransport"],
      "properties": {
        "pairId": { "$ref": "#/definitions/digest" },
        "source": { "$ref": "#/definitions/vm" },
        "target": { "$ref": "#/definitions/vm" },
        "selectedTransport": { "enum": ["bits", "filesystem", "scp"] }
      }
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "planId", "requestId", "profileId", "selectedTransport", "pairs"],
      "properties": {
        "schemaVersion": { "const": "pedantic.hyperv-transfer-plan.v1" },
        "planId": { "$ref": "#/definitions/digest" },
        "requestId": { "type": "string", "minLength": 1 },
        "profileId": { "type": "string", "minLength": 1 },
        "selectedTransport": { "enum": ["bits", "filesystem", "scp"] },
        "pairs": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/pair" } }
      }
    }
  }
}
