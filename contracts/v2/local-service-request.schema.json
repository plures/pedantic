{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.pedantic.dev/contracts/v2/local-service-request.schema.json",
  "title": "Explicit v2 profile remediation request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "method", "profileId", "authorization", "params"],
  "properties": {
    "schemaVersion": { "const": "pedantic.local-service-request.v2" },
    "id": { "type": "string", "minLength": 1, "maxLength": 256 },
    "method": { "enum": ["effect.authorize", "effect.verify", "effect.revoke", "remediation.execute"] },
    "profileId": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[A-Za-z0-9_][A-Za-z0-9_-]*$" },
    "authorization": { "type": "string", "minLength": 32 },
    "params": { "type": "object" }
  },
  "allOf": [
    {
      "if": { "properties": { "method": { "const": "effect.authorize" } } },
      "then": { "properties": { "params": {
        "type": "object", "additionalProperties": false, "required": ["approvalId"],
        "properties": { "approvalId": { "$ref": "#/definitions/id" } }
      } } }
    },
    {
      "if": { "properties": { "method": { "const": "effect.revoke" } } },
      "then": { "properties": { "params": {
        "type": "object", "additionalProperties": false, "required": ["authorizationId"],
        "properties": { "authorizationId": { "$ref": "#/definitions/id" } }
      } } }
    },
    {
      "if": { "properties": { "method": { "const": "effect.verify" } } },
      "then": { "properties": { "params": {
        "type": "object", "additionalProperties": false,
        "required": ["authorizationId", "authorization", "inputDigest", "idempotencyKey"],
        "properties": {
          "authorizationId": { "$ref": "#/definitions/id" },
          "authorization": { "type": "object" },
          "inputDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
          "idempotencyKey": { "$ref": "#/definitions/id" }
        }
      } } }
    },
    {
      "if": { "properties": { "method": { "const": "remediation.execute" } } },
      "then": { "properties": { "params": {
        "type": "object", "additionalProperties": false,
        "required": ["executionId", "authorizationId", "idempotencyKey", "document", "authorization"],
        "properties": {
          "executionId": { "$ref": "#/definitions/id" },
          "authorizationId": { "$ref": "#/definitions/id" },
          "idempotencyKey": { "$ref": "#/definitions/id" },
          "document": { "type": "string", "minLength": 1 },
          "authorization": { "type": "object" }
        }
      } } }
    }
  ],
  "definitions": {
    "id": { "type": "string", "minLength": 1, "maxLength": 256 }
  }
}
