{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.pedantic.dev/contracts/v2/resolved-plan.schema.json",
  "title": "Pedantic immutable resolved plan v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "planId", "planRevision", "operationId", "profileId", "targetId", "executionMode", "resolvedSettings", "steps"],
  "properties": {
    "schemaVersion": { "const": "pedantic.resolved-plan.v2" },
    "planId": { "$ref": "#/definitions/id" },
    "planRevision": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "operationId": { "$ref": "#/definitions/id" },
    "profileId": { "$ref": "#/definitions/id" },
    "targetId": { "$ref": "#/definitions/id" },
    "executionMode": { "enum": ["agentless", "ephemeral-agent"] },
    "resolvedSettings": {
      "type": "object",
      "propertyNames": { "minLength": 1 },
      "additionalProperties": { "$ref": "#/definitions/setting" }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1024,
      "items": { "$ref": "#/definitions/step" }
    }
  },
  "definitions": {
    "id": { "type": "string", "minLength": 1, "maxLength": 256 },
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "setting": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "source", "sourceRevision"],
      "properties": {
        "value": {},
        "source": { "enum": ["builtIn", "general", "target", "plan"] },
        "sourceRevision": { "$ref": "#/definitions/id" }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stepId", "stage", "capability", "dependsOn", "retryClass", "inputDigest", "secretReferences"],
      "properties": {
        "stepId": { "$ref": "#/definitions/id" },
        "stage": { "enum": ["preparation", "execution"] },
        "capability": { "type": "string", "pattern": "^[a-z][a-z0-9.-]*/v[1-9][0-9]*$" },
        "dependsOn": { "type": "array", "maxItems": 1024, "uniqueItems": true, "items": { "$ref": "#/definitions/id" } },
        "retryClass": { "enum": ["never", "safe", "safe-after-observation", "requires-fresh-authorization", "requires-operator-review", "compensate-then-retry"] },
        "inputDigest": { "$ref": "#/definitions/digest" },
        "secretReferences": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/definitions/id" } }
      }
    }
  }
}
