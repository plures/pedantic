  "args": {
    "argv": [
      "ip",
      "link",
      "add",
      "link",
      "eth0",
      "name",
      "pedanticvlan42",
      "type",
      "vlan",
      "id",
      "42"
    ],
    "creates": "/sys/class/net/pedanticvlan42"
